+static constexpr int ssm_conv_head = 128; // block size = head size of the optional norms
+
+template <int d_conv>
+__launch_bounds__(ssm_conv_head)
+static __global__ void ssm_conv_cached_state_f32(
+        const float * __restrict__ state_rows, const int32_t * __restrict__ ids, const int64_t row_stride,
+        const float * __restrict__ x, const int64_t x_stride, const float * __restrict__ w, const int64_t w_stride,
+        float * __restrict__ y, float * __restrict__ state_dst, const int nr,
