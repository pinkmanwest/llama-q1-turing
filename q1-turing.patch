+                                            const int ncols, const float eps, char * __restrict__ q1t) {
+    constexpr int block_size = 1024;
+    extern __shared__ float s_sum[];
+    const int tid = threadIdx.x;
+    const int n_per = ncols / block_size;
+
+    ggml_cuda_pdl_sync();
+    const int   col = tid + blockIdx.x*block_size;
+    const float w   = mul[col];
+    float xv[max_per_thread];
+#pragma unroll
+    for (int k = 0; k < max_per_thread; ++k) {
+        if (k < n_per) {
+            xv[k] = x[tid + k*block_size];
+        }
+    }
+    float tmp = 0.0f;
+#pragma unroll
+    for (int k = 0; k < max_per_thread; ++k) {
+        if (k < n_per) {
+            tmp += xv[k] * xv[k];
+        }
