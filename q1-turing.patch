+// Q1_0 x one column on Turing. Each warp owns rows_per_warp rows over its share of K, so partial sums need only a
+// warp reduction, plus a small shared-memory one when K is split across warps.
+//
+// Activations use a transposed Q8 layout: within each 32-element block, word g of 8 holds x[g], x[8+g], x[16+g],
+// x[24+g] in its bytes. Bit g of every Q1_0 weight byte then lines up with one DP4A lane, so the 0/1 masks of the
+// exact sum 2*sum(x where bit set) - sum(x) need one LOP3 each. Layout per column, nb = padded_ncols/QK8_1:
+// [nb] uint4 words 0..3, [nb] uint4 words 4..7, [nb] int2 {float bits of d/8, -8*sum(q)}.
+static constexpr int    q1t_nwarps          = 4;
+static constexpr size_t q1t_bytes_per_block = 2*sizeof(uint4) + sizeof(int2);
+
+// Q1T activations of the last src1 of a context, so that the following matmuls of the same graph that read the
+// same tensor (Q/K/V, the projections of a linear-attention layer) skip quantizing it again. The buffer is
+// allocated once and never moves, because captured CUDA graphs keep its address; it is invalidated at the start
+// of every graph compute and not used with concurrent streams.
+struct q1t_act_cache {
+    int                 device = -1;
+    char              * buf    = nullptr;
+    const ggml_tensor * src    = nullptr; // tensor whose activations buf holds, nullptr when stale
+    const void        * data   = nullptr;
+};
+static constexpr size_t q1t_act_cache_size = 128*1024;
+static std::mutex q1t_act_cache_mutex;
+static std::unordered_map<const ggml_backend_cuda_context *, q1t_act_cache> q1t_act_caches;
+
+void ggml_cuda_mmvq_graph_begin(ggml_backend_cuda_context & ctx) {
+    std::lock_guard<std::mutex> lock(q1t_act_cache_mutex);
+    const auto it = q1t_act_caches.find(&ctx);
+    if (it != q1t_act_caches.end()) {
+        it->second.src = nullptr;
+    }
+}
+
+static q1t_act_cache * q1t_act_cache_get(ggml_backend_cuda_context & ctx, const size_t size, cudaStream_t stream) {
+    static const bool disabled = getenv("GGML_CUDA_DISABLE_Q1T_REUSE") != nullptr;
+    if (disabled || ctx.curr_stream_no != 0 || size > q1t_act_cache_size) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(q1t_act_cache_mutex);
+    q1t_act_cache & c = q1t_act_caches[&ctx];
+    if (c.buf != nullptr && c.device != ctx.device) {
+        return nullptr;
+    }
+    if (c.buf == nullptr) {
+        cudaStreamCaptureStatus status = cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(stream, &status));
+        if (status != cudaStreamCaptureStatusNone) {
+            return nullptr;
+        }
+        CUDA_CHECK(cudaMalloc((void **) &c.buf, q1t_act_cache_size));
+        c.device = ctx.device;
+    }
+    return &c;
+}
+
+static bool ggml_cuda_q1t_disabled() {
+    static const bool disabled = getenv("GGML_CUDA_DISABLE_Q1T") != nullptr;
+    return disabled;
+}
