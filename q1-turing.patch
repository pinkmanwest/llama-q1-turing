diff --git a/ggml/src/ggml-cuda/fattn-gqa-dec.cuh b/ggml/src/ggml-cuda/fattn-gqa-dec.cuh
new file mode 100644
index 000000000..fbd3b57f7
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-gqa-dec.cuh
@@ -0,0 +1,225 @@
+#pragma once
+
+#include "common.cuh"
+
+// Single-token attention with f16 K/V for Turing GPUs (e.g. TU11x without tensor cores, where the MMA kernel runs
+// one block per SM). One block covers one KV head and a chunk of fattn_gqa_dec_chunk KV positions for all G query
+// heads of that KV head, so K and V are read once and the grid scales with the context length. Each block keeps
+// an unnormalized output with its softmax max and sum; fattn_gqa_dec_combine merges the chunks.
+
+static constexpr int fattn_gqa_dec_chunk = 128; // KV positions per block, one per thread in the K pass
+
+template <int D, int G>
+__launch_bounds__(fattn_gqa_dec_chunk, 4)
+static __global__ void fattn_gqa_dec(
+        const char * __restrict__ Q, const char * __restrict__ K, const char * __restrict__ V, const half * __restrict__ mask,
+        float * __restrict__ part_o, float2 * __restrict__ part_ml, const float scale, const int nchunks,
+        const int64_t nbq2, const int64_t nbk1, const int64_t nbk2, const int64_t nbv1, const int64_t nbv2) {
+    static_assert(D % (2*fattn_gqa_dec_chunk) == 0, "each thread owns an even number of output dims");
+    constexpr int nwarps   = fattn_gqa_dec_chunk / WARP_SIZE;
+    constexpr int dims_per = D / fattn_gqa_dec_chunk;
+
+    const int t     = threadIdx.x;
+    const int chunk = blockIdx.x;
+    const int kvh   = blockIdx.y;
+    const int j     = chunk*fattn_gqa_dec_chunk + t;
+
+    __shared__ float q_s[G][D];
+    __shared__ float p_s[fattn_gqa_dec_chunk][G];
+    __shared__ float red_s[nwarps][G];
+
+    ggml_cuda_pdl_sync();
+    for (int i = t; i < G*D; i += fattn_gqa_dec_chunk) {
+        const int h = i / D;
+        q_s[h][i % D] = ((const float *) (Q + (kvh*G + h)*nbq2))[i % D] * scale;
+    }
+    __syncthreads();
+
+    // K pass: thread t scores KV position j against every query head of the group
+    float s[G] = {0.0f};
+    const char * k_row = K + kvh*nbk2 + j*nbk1;
+#pragma unroll 4
+    for (int d = 0; d < D; d += 8) {
+        const uint4 raw = *(const uint4 *) (k_row + d*sizeof(half));
+        const float2 k0 = __half22float2(*(const half2 *) &raw.x);
+        const float2 k1 = __half22float2(*(const half2 *) &raw.y);
+        const float2 k2 = __half22float2(*(const half2 *) &raw.z);
+        const float2 k3 = __half22float2(*(const half2 *) &raw.w);
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+            const float4 qa = *(const float4 *) &q_s[h][d];
+            const float4 qb = *(const float4 *) &q_s[h][d + 4];
+            s[h] += qa.x*k0.x + qa.y*k0.y + qa.z*k1.x + qa.w*k1.y + qb.x*k2.x + qb.y*k2.y + qb.z*k3.x + qb.w*k3.y;
+        }
+    }
+    const float mval = mask ? __half2float(mask[j]) : 0.0f;
+
+    // softmax statistics of this chunk, per head
+    const int lane = t % WARP_SIZE;
+    const int warp = t / WARP_SIZE;
+    float m[G];
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+        s[h] += mval;
+        const float wm = warp_reduce_max(s[h]);
+        if (lane == 0) {
+            red_s[warp][h] = wm;
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+        m[h] = red_s[0][h];
+#pragma unroll
+        for (int w = 1; w < nwarps; ++w) {
+            m[h] = fmaxf(m[h], red_s[w][h]);
+        }
+    }
+    __syncthreads();
+    float l[G];
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+        const float p = m[h] == -INFINITY ? 0.0f : expf(s[h] - m[h]);
+        p_s[t][h] = p;
+        const float wl = warp_reduce_sum(p);
+        if (lane == 0) {
+            red_s[warp][h] = wl;
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+        l[h] = 0.0f;
+#pragma unroll
+        for (int w = 0; w < nwarps; ++w) {
+            l[h] += red_s[w][h];
+        }
+    }
+
+    // V pass: thread t accumulates output dims [dims_per*t, dims_per*(t+1)) over the chunk
+    float o[G][dims_per] = {{0.0f}};
+    const char * v_col = V + kvh*nbv2 + (int64_t) chunk*fattn_gqa_dec_chunk*nbv1 + dims_per*t*sizeof(half);
+#pragma unroll 8
+    for (int jj = 0; jj < fattn_gqa_dec_chunk; ++jj) {
+        float vf[dims_per];
+#pragma unroll
+        for (int k = 0; k < dims_per; k += 2) {
+            const float2 v2 = __half22float2(*(const half2 *) (v_col + jj*nbv1 + k*sizeof(half)));
+            vf[k + 0] = v2.x;
+            vf[k + 1] = v2.y;
+        }
+#pragma unroll
+        for (int h = 0; h < G; ++h) {
+            const float p = p_s[jj][h];
+#pragma unroll
+            for (int k = 0; k < dims_per; ++k) {
+                o[h][k] += p*vf[k];
+            }
+        }
+    }
+
+#pragma unroll
+    for (int h = 0; h < G; ++h) {
+        const int qh = kvh*G + h;
+        float * dst = part_o + ((int64_t) qh*nchunks + chunk)*D + dims_per*t;
+#pragma unroll
+        for (int k = 0; k < dims_per; ++k) {
+            dst[k] = o[h][k];
+        }
+        if (t == 0) {
+            part_ml[qh*nchunks + chunk] = make_float2(m[h], l[h]);
+        }
+    }
+}
+
+template <int D>
+static __global__ void fattn_gqa_dec_combine(
+        const float * __restrict__ part_o, const float2 * __restrict__ part_ml, float * __restrict__ dst, const int nchunks) {
+    const int qh = blockIdx.x;
+    const int d  = threadIdx.x;
+    const float2 * ml = part_ml + qh*nchunks;
+
+    float M = -INFINITY;
+    for (int c = 0; c < nchunks; ++c) {
+        M = fmaxf(M, ml[c].x);
+    }
+    float L = 0.0f;
+    float O = 0.0f;
+    for (int c = 0; c < nchunks; ++c) {
+        const float w = ml[c].x == -INFINITY ? 0.0f : expf(ml[c].x - M);
+        L += w*ml[c].y;
+        O += w*part_o[((int64_t) qh*nchunks + c)*D + d];
+    }
+    dst[qh*D + d] = O / L;
+}
+
+static bool ggml_cuda_fattn_gqa_dec_supported(const int cc, const ggml_tensor * dst) {
+    static const bool disabled = getenv("GGML_CUDA_DISABLE_FATTN_GQA_DEC") != nullptr;
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    if (disabled || !GGML_CUDA_CC_IS_NVIDIA(cc) || cc != GGML_CUDA_CC_TURING || sinks || max_bias != 0.0f || logit_softcap != 0.0f) {
+        return false;
+    }
+    if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 || dst->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (Q->ne[1] != 1 || Q->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1 || Q->ne[0] != K->ne[0] || V->ne[0] != Q->ne[0] ||
+        Q->ne[0] != 256 || K->ne[1] % fattn_gqa_dec_chunk != 0 || K->ne[1] != V->ne[1]) {
+        return false;
+    }
+    const int64_t gqa = Q->ne[2] / K->ne[2];
+    if (Q->ne[2] % K->ne[2] != 0 || (gqa != 4 && gqa != 6 && gqa != 8) || V->ne[2] != K->ne[2]) {
+        return false;
+    }
+    if (K->nb[0] != sizeof(half) || V->nb[0] != sizeof(half) || K->nb[1] % 16 != 0 || V->nb[1] % 4 != 0 || Q->nb[0] != sizeof(float)) {
+        return false;
+    }
+    if (mask && (mask->type != GGML_TYPE_F16 || mask->ne[0] < K->ne[1] || mask->ne[2] != 1 || mask->ne[3] != 1)) {
+        return false;
+    }
+    return true;
+}
+
+template <int D, int G>
+static void ggml_cuda_fattn_gqa_dec_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const float scale) {
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    cudaStream_t stream = ctx.stream();
+
+    const int nchunks = K->ne[1] / fattn_gqa_dec_chunk;
+    const int nqh     = Q->ne[2];
+    ggml_cuda_pool_alloc<float>  part_o (ctx.pool(), (size_t) nqh*nchunks*D);
+    ggml_cuda_pool_alloc<float2> part_ml(ctx.pool(), (size_t) nqh*nchunks);
+
+    const dim3 grid(nchunks, K->ne[2], 1);
+    fattn_gqa_dec<D, G><<<grid, fattn_gqa_dec_chunk, 0, stream>>>(
+        (const char *) Q->data, (const char *) K->data, (const char *) V->data, mask ? (const half *) mask->data : nullptr,
+        part_o.get(), part_ml.get(), scale, nchunks, Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2]);
+    fattn_gqa_dec_combine<D><<<nqh, D, 0, stream>>>(part_o.get(), part_ml.get(), (float *) dst->data, nchunks);
+}
+
+static void ggml_cuda_fattn_gqa_dec(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    float scale = 1.0f;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+    const int gqa = Q->ne[2] / K->ne[2];
+    switch (Q->ne[0]*16 + gqa) {
+        case 256*16 + 4: ggml_cuda_fattn_gqa_dec_launch<256, 4>(ctx, dst, scale); break;
+        case 256*16 + 6: ggml_cuda_fattn_gqa_dec_launch<256, 6>(ctx, dst, scale); break;
+        case 256*16 + 8: ggml_cuda_fattn_gqa_dec_launch<256, 8>(ctx, dst, scale); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
