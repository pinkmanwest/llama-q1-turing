+    // select the norm by value: taking the address of a kernel parameter would move it to local memory
+    const int  blk_c0 = blockIdx.x*blockDim.x;
+    const bool in0    = norm0.out && blk_c0 >= norm0.c0 && blk_c0 < norm0.c0 + norm0.nch;
+    const bool in1    = !in0 && norm1.out && blk_c0 >= norm1.c0 && blk_c0 < norm1.c0 + norm1.nch;
+    if (in0 || in1) {
+        float *     out       = in0 ? norm0.out   : norm1.out;
+        const int   c0        = in0 ? norm0.c0    : norm1.c0;
+        const float eps       = in0 ? norm0.eps   : norm1.eps;
+        const float scale_out = in0 ? norm0.scale : norm1.scale;
