+// Uploads from pageable host memory are staged by the CUDA runtime before cudaMemcpyAsync returns, so they need
+// no synchronization for the sake of the host buffer. Instead of waiting, the upload stream (cudaStreamPerThread
+// of the calling thread) records an event, and streams that later use the device wait for the pending events.
+struct ggml_cuda_pending_uploads {
+    std::mutex                                       mutex;
+    std::unordered_map<std::thread::id, cudaEvent_t> events;  // one per uploading thread, re-recorded
+    std::vector<cudaEvent_t>                         pending;
+};
+
+static ggml_cuda_pending_uploads & ggml_cuda_get_pending_uploads(int device) {
+    static ggml_cuda_pending_uploads uploads[GGML_CUDA_MAX_DEVICES];
+    return uploads[device];
+}
+
+static bool ggml_cuda_host_ptr_is_pageable(const void * ptr) {
+    cudaPointerAttributes attr;
+    if (cudaPointerGetAttributes(&attr, ptr) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return attr.type == cudaMemoryTypeUnregistered;
+}
+
+// host-to-device copy on cudaStreamPerThread, with device current; returns without waiting for the copy. Small
+// copies from pinned memory, which the runtime does not stage, go through a pageable bounce buffer.
+static void ggml_cuda_upload(int device, void * dst, const void * src, size_t size) {
+    static const bool sync_uploads = getenv("GGML_CUDA_SYNC_UPLOADS") != nullptr;
+    constexpr size_t max_bounce = 1 << 20;
+    const bool pageable = ggml_cuda_host_ptr_is_pageable(src);
+    if (sync_uploads || (!pageable && size > max_bounce)) {
+        CUDA_CHECK(cudaMemcpyAsync(dst, src, size, cudaMemcpyHostToDevice, cudaStreamPerThread));
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+        return;
+    }
+    if (!pageable) {
+        thread_local std::vector<char> bounce;
+        bounce.resize(size);
+        memcpy(bounce.data(), src, size);
+        src = bounce.data();
+    }
+    CUDA_CHECK(cudaMemcpyAsync(dst, src, size, cudaMemcpyHostToDevice, cudaStreamPerThread));
+
+    ggml_cuda_pending_uploads & u = ggml_cuda_get_pending_uploads(device);
+    std::lock_guard<std::mutex> lock(u.mutex);
+    cudaEvent_t & ev = u.events[std::this_thread::get_id()];
+    if (ev == nullptr) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&ev, cudaEventDisableTiming));
+    }
+    CUDA_CHECK(cudaEventRecord(ev, cudaStreamPerThread));
+    if (std::find(u.pending.begin(), u.pending.end(), ev) == u.pending.end()) {
+        u.pending.push_back(ev);
+    }
+}
+
+// make stream (on device, which must be current) wait for the pending uploads to device
+static void ggml_cuda_wait_uploads(int device, cudaStream_t stream) {
+    ggml_cuda_pending_uploads & u = ggml_cuda_get_pending_uploads(device);
+    std::lock_guard<std::mutex> lock(u.mutex);
+    for (cudaEvent_t ev : u.pending) {
+        CUDA_CHECK(cudaStreamWaitEvent(stream, ev, 0));
+    }
+    u.pending.clear();
+}
