+// them. For a single sequence whose gathered row only feeds a cache-fused gated_delta_net, the kernel can read
+// the cache row through the gather ids instead, and the gather (a full state copy per layer) is skipped.
+// Each GDN thread reads its state elements before writing the same positions, so reading and writing one
+// cache row in the same kernel is safe; with several sequences rows of different blocks could overlap.
+// Returns the index of the gated_delta_net node, or -1.
+static int ggml_cuda_gdn_state_gather_target(const ggml_cgraph * cgraph, int gather_idx) {
+    const ggml_tensor * gather = cgraph->nodes[gather_idx];
+    if (gather->op != GGML_OP_GET_ROWS || gather->type != GGML_TYPE_F32 || (gather->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        gather->ne[1] != 1 || gather->ne[2] != 1 || gather->ne[3] != 1) {
+        return -1;
+    }
+    const ggml_tensor * rows = gather->src[0];
+    const ggml_tensor * ids  = gather->src[1];
+    if (rows->type != GGML_TYPE_F32 || rows->nb[0] != sizeof(float) || ids->type != GGML_TYPE_I32 || rows->data == nullptr) {
+        return -1;
+    }
+    const ggml_tensor * rows_root = rows->view_src ? rows->view_src : rows;
+
+    int gdn_idx = -1;
+    for (int j = gather_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        // nothing may write the cache rows before the gated_delta_net has read them
+        if (gdn_idx < 0 && (n == rows_root || n->view_src == rows_root)) {
+            return -1;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = n->src[s];
+            if (src == nullptr || (src != gather && src->view_src != gather)) {
+                continue;
+            }
+            if (ggml_is_empty(src)) {
+                continue;
+            }
+            if (n->op != GGML_OP_GATED_DELTA_NET || s != 5 || gdn_idx >= 0 || src->data != gather->data ||
+                ggml_nelements(src) != gather->ne[0] || !ggml_is_contiguous(src) || src->ne[3] != 1) {
+                return -1;
+            }
+            gdn_idx = j;
+        }
+    }
+    if (gdn_idx < 0) {
+        return -1;
+    }
+    ggml_cuda_gated_delta_net_fused_cache unused;
+    return ggml_cuda_try_gdn_cache_fusion(cgraph, gdn_idx, unused) > 0 ? gdn_idx : -1;
+}
+
+static bool ggml_cuda_ranges_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (a == nullptr || b == nullptr || a->data == nullptr || b->data == nullptr || ggml_is_empty(a) || ggml_is_empty(b)) {
+        return false;
+    }
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+// Collects later MUL_MAT nodes that read the same src1 as node i and that the Q1T kernel can compute in the same
+// launch. Computing node j at position i is safe when no node in between touches the memory of node j's result
+// (the allocator may have given it memory of a tensor that is still live at i) and none writes src1. Nodes whose
+// result feeds an op right after them are left alone, because they may be fused there (bias add, glu).
+static int ggml_cuda_collect_q1t_batch(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i,
+                                       ggml_tensor ** batch, const std::vector<const ggml_tensor *> & batched) {
+    ggml_tensor * node = cgraph->nodes[i];
+    batch[0] = node;
+    int n = 1;
+    if (!cuda_ctx->stream_context().concurrent_events.empty() || !ggml_cuda_mmvq_q1t_batchable(*cuda_ctx, node)) {
+        return n;
+    }
+    const ggml_tensor * src1 = node->src[1];
+    constexpr int max_scan = 512;
+    for (int j = i + 1; j < cgraph->n_nodes && j <= i + max_scan && n < GGML_CUDA_MMVQ_MAX_BATCH_MATS; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        if (ggml_cuda_ranges_overlap(cand, src1)) {
+            break; // src1 is written from here on
+        }
+        if (cand->op != GGML_OP_MUL_MAT || cand->src[1] != src1 || cand->src[0]->ne[0] != node->src[0]->ne[0] ||
+            cand->src[0]->nb[1] != node->src[0]->nb[1] || !ggml_cuda_mmvq_q1t_batchable(*cuda_ctx, cand) ||
+            (cand->flags & GGML_TENSOR_FLAG_OUTPUT) || std::find(batched.begin(), batched.end(), cand) != batched.end()) {
+            continue;
+        }
+        // leave the matmul to the mul_mat + add/mul/glu fusions, which need the very next node to read it directly
+        bool fusable_next = false;
+        if (j + 1 < cgraph->n_nodes) {
+            const ggml_tensor * nk = cgraph->nodes[j + 1];
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                fusable_next |= nk->src[s] == cand &&
+                                (nk->op == GGML_OP_ADD || nk->op == GGML_OP_MUL || nk->op == GGML_OP_GLU);
+            }
+        }
+        if (fusable_next) {
+            continue;
+        }
+        bool safe = true;
+        for (int k = i + 1; k < j && safe; ++k) {
+            const ggml_tensor * nk = cgraph->nodes[k];
+            safe = !ggml_cuda_ranges_overlap(nk, cand);
+            for (int s = 0; s < GGML_MAX_SRC && safe; ++s) {
+                safe = !ggml_cuda_ranges_overlap(nk->src[s], cand);
+            }
+        }
+        if (safe) {
+            batch[n++] = cand;
+        }
+    }
+    return n;
+}
+
+// Single-token causal conv of a recurrent layer: get_rows gathers the cached d_conv-1 columns, concat appends the
+// new column, ssm_conv + silu consumes the window and a cpy writes its last d_conv-1 columns back to the cache. For
+// one sequence this matches one kernel that reads and writes the cache row directly.
+struct ggml_cuda_conv_state_plan {
+    const ggml_tensor * gather = nullptr;
+    const ggml_tensor * concat = nullptr;
+    const ggml_tensor * conv   = nullptr;
+    ggml_tensor       * silu   = nullptr;
+    const ggml_tensor * cpy    = nullptr;
+    // per-head L2 norms (rms_norm + scale) of channel ranges of the silu output, computed by the same kernel
+    int                      n_norms = 0;
+    const ggml_tensor *      norm_nodes[2]  = { nullptr, nullptr };
+    const ggml_tensor *      scale_nodes[2] = { nullptr, nullptr };
+    ggml_cuda_conv_head_norm norms[2];
+};
+
+static bool ggml_cuda_tensor_reads(const ggml_tensor * n, const ggml_tensor * t) {
+    for (int s = 0; s < GGML_MAX_SRC; ++s) {
+        const ggml_tensor * src = n->src[s];
+        if (src != nullptr && (src == t || src->view_src == t)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool ggml_cuda_match_conv_state(const ggml_cgraph * cgraph, int gi, ggml_cuda_conv_state_plan & plan) {
+    const ggml_tensor * gather = cgraph->nodes[gi];
+    if (gather->op != GGML_OP_GET_ROWS || gather->type != GGML_TYPE_F32 || (gather->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        gather->ne[1] != 1 || gather->ne[2] != 1 || gather->ne[3] != 1 || gather->src[0]->type != GGML_TYPE_F32 ||
+        gather->src[0]->nb[0] != sizeof(float) || gather->src[1]->type != GGML_TYPE_I32 || gather->src[0]->data == nullptr) {
+        return false;
+    }
+    const ggml_tensor * rows_root = gather->src[0]->view_src ? gather->src[0]->view_src : gather->src[0];
+
+    // the gathered row feeds exactly one concat
+    int ci = -1;
+    for (int j = gi + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n) || !ggml_cuda_tensor_reads(n, gather)) {
+            continue;
+        }
+        if (ci >= 0 || n->op != GGML_OP_CONCAT) {
+            return false;
+        }
+        ci = j;
+    }
+    if (ci < 0) {
+        return false;
+    }
+    const ggml_tensor * concat = cgraph->nodes[ci];
+    const ggml_tensor * x      = concat->src[1];
+    const int64_t d_conv = concat->ne[0];
+    const int64_t nr     = concat->ne[1];
+    if (ggml_get_op_params_i32(concat, 0) != 0 || concat->type != GGML_TYPE_F32 || (concat->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        d_conv != 4 || nr % 128 != 0 || concat->ne[2] != 1 || concat->ne[3] != 1 || !ggml_is_contiguous(concat) ||
+        concat->src[0]->data != gather->data || concat->src[0]->ne[0] != d_conv - 1 || gather->ne[0] != (d_conv - 1)*nr ||
+        x->type != GGML_TYPE_F32 || x->ne[0] != 1 || x->ne[1] != nr || x->nb[1] % sizeof(float) != 0) {
+        return false;
+    }
+
+    // the window feeds the conv (followed by silu) and a cpy of its last d_conv-1 columns
+    int si = -1;
+    int pi = -1;
+    for (int j = ci + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n) || !ggml_cuda_tensor_reads(n, concat)) {
+            continue;
+        }
+        if (n->op == GGML_OP_SSM_CONV && si < 0 && n->src[0] == concat) {
+            si = j;
+        } else if (n->op == GGML_OP_CPY && pi < 0 && n->src[0]->view_src == concat) {
+            pi = j;
+        } else {
+            return false;
+        }
+    }
+    if (si < 0 || pi < 0 || si + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * conv = cgraph->nodes[si];
+    ggml_tensor       * silu = cgraph->nodes[si + 1];
+    const ggml_tensor * cpy  = cgraph->nodes[pi];
+    const ggml_tensor * w    = conv->src[1];
+    if (silu->op != GGML_OP_UNARY || ggml_get_unary_op(silu) != GGML_UNARY_OP_SILU || silu->src[0] != conv ||
+        silu->type != GGML_TYPE_F32 || !ggml_is_contiguous(silu) || ggml_nelements(silu) != nr ||
+        w->type != GGML_TYPE_F32 || w->ne[0] != d_conv || w->ne[1] != nr || w->nb[0] != sizeof(float) ||
+        (conv->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    for (int j = si + 2; j < cgraph->n_nodes; ++j) {
+        if (!ggml_cuda_is_view_or_noop(cgraph->nodes[j]) && ggml_cuda_tensor_reads(cgraph->nodes[j], conv)) {
+            return false;
+        }
+    }
+    const ggml_tensor * view = cpy->src[0];
+    const ggml_tensor * sdst = cpy->src[1];
+    if (view->view_offs != sizeof(float) || view->ne[0] != d_conv - 1 || view->ne[1] != nr || view->ne[2] != 1 ||
+        sdst->type != GGML_TYPE_F32 || !ggml_is_contiguous(sdst) || ggml_nelements(sdst) != (d_conv - 1)*nr ||
+        (cpy->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    // The fused kernel runs at the concat: x is only guaranteed intact there, the allocator may reuse its memory
+    // right after. Up to the later of conv and cpy, no other node may read or write the cache, and between the
+    // concat and the silu none may touch the silu output, which is then written early.
+    const int last = std::max(si + 1, pi);
+    for (int j = gi + 1; j <= last; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n == cpy || n == concat || n == conv || n == silu || ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->view_src == rows_root || n == rows_root || ggml_cuda_ranges_overlap(n, sdst) || ggml_cuda_tensor_reads(n, rows_root)) {
+            return false;
+        }
+        for (int k = 0; k < GGML_MAX_SRC && j > ci && j <= si; ++k) {
+            if (ggml_cuda_ranges_overlap(n->src[k], silu)) {
+                return false;
+            }
+        }
+        if (j > ci && j <= si && ggml_cuda_ranges_overlap(n, silu)) {
+            return false;
+        }
+    }
+    plan = {};
+    plan.gather = gather;
+    plan.concat = concat;
+    plan.conv   = conv;
+    plan.silu   = silu;
+    plan.cpy    = cpy;
+
+    // rms_norm + scale over 128-wide heads of a channel range of the silu output (the L2 norms of q and k)
+    for (int j = si + 2; j + 1 < cgraph->n_nodes && plan.n_norms < 2; ++j) {
+        const ggml_tensor * rn = cgraph->nodes[j];
+        const ggml_tensor * sc = cgraph->nodes[j + 1];
+        if (rn->op != GGML_OP_RMS_NORM || rn->src[0]->view_src != silu || sc->op != GGML_OP_SCALE || sc->src[0] != rn) {
+            continue;
+        }
+        const ggml_tensor * view = rn->src[0];
+        float eps, scale, bias;
+        memcpy(&eps,   rn->op_params, sizeof(float));
+        memcpy(&scale, (const float *) sc->op_params + 0, sizeof(float));
+        memcpy(&bias,  (const float *) sc->op_params + 1, sizeof(float));
+        if (view->ne[0] != 128 || view->nb[1] != 128*sizeof(float) || view->ne[2]*view->ne[3] != 1 || view->view_offs % (128*sizeof(float)) != 0 ||
+            sc->type != GGML_TYPE_F32 || !ggml_is_contiguous(sc) || bias != 0.0f || (rn->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            (sc->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            continue;
+        }
+        // the rms_norm feeds only the scale, and the scale output may be written early, at the concat
+        bool ok = true;
+        for (int k = ci + 1; k < cgraph->n_nodes && ok; ++k) {
+            const ggml_tensor * n = cgraph->nodes[k];
+            if (n == sc || n == rn || ggml_cuda_is_view_or_noop(n) || n == plan.norm_nodes[0] || n == plan.scale_nodes[0] ||
+                n == gather || n == concat || n == conv || n == silu || n == cpy) {
+                continue; // nodes already taken over by the fused kernel do not run
+            }
+            if (ggml_cuda_tensor_reads(n, rn)) {
+                ok = false;
+            }
+            if (k < j + 1) {
+                ok = ok && !ggml_cuda_ranges_overlap(n, sc);
+                for (int s = 0; s < GGML_MAX_SRC && ok; ++s) {
+                    ok = !ggml_cuda_ranges_overlap(n->src[s], sc);
+                }
+            }
+        }
+        if (!ok) {
+            continue;
+        }
+        ggml_cuda_conv_head_norm & hn = plan.norms[plan.n_norms];
+        hn.out   = (float *) sc->data;
+        hn.c0    = view->view_offs / sizeof(float);
+        hn.nch   = view->ne[0]*view->ne[1];
+        hn.eps   = eps;
+        hn.scale = scale;
+        plan.norm_nodes[plan.n_norms]  = rn;
+        plan.scale_nodes[plan.n_norms] = sc;
+        plan.n_norms++;
+    }
+    return true;
+}
+
+// rms_norm(x) * w followed by silu(z) * that, over 128-wide rows (the gated norm of a linear-attention layer).
+// The fused kernel runs at the rms_norm, so z must already have been computed and nothing up to the final mul may
+// touch its output, which is written early.
+struct ggml_cuda_gated_norm_plan {
+    const ggml_tensor * norm  = nullptr;
+    const ggml_tensor * mul_w = nullptr;
+    const ggml_tensor * silu  = nullptr;
+    ggml_tensor       * out   = nullptr; // the final mul
+    const ggml_tensor * mm_y  = nullptr; // view of out read by a matmul as src1, for the Q1T activations
+};
+
+static bool ggml_cuda_match_gated_norm(const ggml_cgraph * cgraph, int i, const std::vector<const ggml_tensor *> & computed_early,
+                                       ggml_cuda_gated_norm_plan & plan) {
+    const ggml_tensor * norm = cgraph->nodes[i];
+    if (norm->op != GGML_OP_RMS_NORM || i + 1 >= cgraph->n_nodes || norm->ne[0] != 128 || norm->type != GGML_TYPE_F32 ||
+        norm->src[0]->nb[0] != sizeof(float) || norm->ne[2]*norm->ne[3] != 1 || (norm->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    const ggml_tensor * mul_w = cgraph->nodes[i + 1];
+    if (mul_w->op != GGML_OP_MUL || mul_w->src[0] != norm || mul_w->src[1]->op != GGML_OP_NONE || mul_w->src[1]->type != GGML_TYPE_F32 ||
+        ggml_nelements(mul_w->src[1]) != 128 || !ggml_is_contiguous(mul_w->src[1]) || (mul_w->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    int mi = -1;
+    for (int j = i + 2; j < cgraph->n_nodes && j <= i + 16; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_MUL && (n->src[0] == mul_w || n->src[1] == mul_w)) {
+            mi = j;
+            break;
+        }
+    }
+    if (mi < 0) {
+        return false;
+    }
+    ggml_tensor * out = cgraph->nodes[mi];
+    const ggml_tensor * silu = out->src[0] == mul_w ? out->src[1] : out->src[0];
+    if (silu->op != GGML_OP_UNARY || ggml_get_unary_op(silu) != GGML_UNARY_OP_SILU || !ggml_are_same_shape(silu, out) ||
+        !ggml_are_same_shape(mul_w, out) || !ggml_is_contiguous(out) || out->type != GGML_TYPE_F32 || (silu->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    const ggml_tensor * z = silu->src[0];
+    const ggml_tensor * z_root = z->view_src ? z->view_src : z;
+    if (!ggml_is_contiguous(z) || z->type != GGML_TYPE_F32 ||
+        std::find(computed_early.begin(), computed_early.end(), z_root) == computed_early.end()) {
+        return false;
+    }
+    // single consumers, and nothing between the norm and the final mul touches the final output
+    const ggml_tensor * internal[] = { norm, mul_w, silu };
+    for (int j = i + 2; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n == out || n == silu || ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        for (const ggml_tensor * t : internal) {
+            if (ggml_cuda_tensor_reads(n, t)) {
+                return false;
+            }
+        }
+        if (j < mi) {
+            if (ggml_cuda_ranges_overlap(n, out)) {
+                return false;
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (ggml_cuda_ranges_overlap(n->src[s], out)) {
+                    return false;
+                }
+            }
+        }
+    }
+    plan = {};
+    plan.norm  = norm;
+    plan.mul_w = mul_w;
+    plan.silu  = silu;
+    plan.out   = out;
+    // the matmul that reads the result, through a view, for the Q1T activations
+    for (int j = mi + 1; j < cgraph->n_nodes && j <= mi + 8; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_MUL_MAT && n->src[1]->data == out->data && (n->src[1] == out || n->src[1]->view_src == out) &&
+            ggml_nelements(n->src[1]) == ggml_nelements(out)) {
+            plan.mm_y = n->src[1];
+            break;
+        }
+    }
+    return true;
+}
+
+static bool ggml_cuda_gdn_state_gather_elided(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disable_fusion = getenv("GGML_CUDA_DISABLE_FUSION") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_FUSION"));
+    return !disable_fusion && cuda_ctx->stream_context().concurrent_events.empty() &&
+           cgraph->nodes[i]->op == GGML_OP_GET_ROWS && ggml_cuda_gdn_state_gather_target(cgraph, i) >= 0;
+}
