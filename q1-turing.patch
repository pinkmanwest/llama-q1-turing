+__launch_bounds__(CUDA_QUANTIZE_BLOCK_SIZE, 1)
+static __global__ void quantize_q8_1_q1t(const float * __restrict__ x, char * __restrict__ vy, const int ne00, const int ne0) {
+    const int i0 = blockDim.x*blockIdx.x + threadIdx.x;
+    if (i0 >= ne0) {
+        return;
+    }
+
+    ggml_cuda_pdl_sync();
+    const float xi   = i0 < ne00 ? x[i0] : 0.0f;
+    const float amax = warp_reduce_max<QK8_1>(fabsf(xi));
+    const float d    = amax / 127.0f;
+    const int   q    = amax == 0.0f ? 0 : roundf(xi / d);
+    const int   sum  = warp_reduce_sum<QK8_1>(q);
+
+    const int nb = ne0 / QK8_1;
+    const int ib = i0 / QK8_1;
+    const int j  = i0 % QK8_1;
+    const int g  = j % 8;
+    vy[(g/4)*16*nb + ib*16 + (g%4)*4 + j/8] = q;
+    if (j == 0) {
+        // same half-rounded scale as block_q8_1, pre-divided by the 8 that q1t_dot multiplies its result with
+        ((int2 *) (vy + 32*nb))[ib] = make_int2(__float_as_int(__half2float(__float2half_rn(d)) * 0.125f), -8*sum);
+    }
+}
+
+// weight halfwords. For long rows, asking L2 for whole 128-byte chunks avoids re-reading sectors that neighbouring
+// K steps of a row share (measured on Turing: 17.5 -> 13.5 MB DRAM reads for 12.5 MB of K = 17408 weights).
+template <bool l2_128>
+static __device__ __forceinline__ uint32_t q1t_load_u16(const void * p) {
+    uint16_t v;
+    if constexpr (l2_128) {
+        asm("ld.global.nc.L2::128B.u16 %0, [%1];" : "=h"(v) : "l"(p));
+    } else {
+        v = *(const uint16_t *) p;
+    }
+    return v;
+}
+
+// 8*(2*sum(u where bit set) - sum(u)) for 32 weights q, c = -8*sum(u)
+static __device__ __forceinline__ int q1t_dot(const uint32_t q, const int (&u)[8], const int c) {
+    int lo = 0; // bits 0..3 of each weight byte, mask value 1
+    int hi = c; // bits 4..7 of each weight byte, mask value 16
+#pragma unroll
+    for (int s = 0; s < 4; ++s) {
+        lo = ggml_cuda_dp4a((q >> s) & 0x01010101, u[s],     lo);
+        hi = ggml_cuda_dp4a((q >> s) & 0x10101010, u[s + 4], hi);
+    }
+    return 16*lo + hi;
+}
+
+// Matrices with the same K and activations, computed by one launch: blocks [block_end[s-1], block_end[s]) of the
+// grid cover matrix s.
+static constexpr int q1t_max_segs = GGML_CUDA_MMVQ_MAX_BATCH_MATS;
+struct q1t_segs {
+    const char * vx[q1t_max_segs];
+    float      * dst[q1t_max_segs];
+    int          nrows[q1t_max_segs];
+    int          block_end[q1t_max_segs];
+    int          n;
+};
+
+// Rows are clamped to the last full group of rows_per_warp, so nrows_x >= rows_per_warp is required; a warp writes
+// only the rows that the previous warp does not own.
+template <int rows_per_warp, int nsplit, bool has_gate, int ncols_c>
+__launch_bounds__(q1t_nwarps*WARP_SIZE, 8)
+static __global__ void mul_mat_vec_q1_0_q1t(
+        const char * __restrict__ vx0, const char * __restrict__ vgate, const char * __restrict__ vy,
+        const float * __restrict__ x_bias, const float * __restrict__ gate_bias, const ggml_glu_op glu_op, const float glu_limit,
+        float * __restrict__ dst0, const int ncols_x, const int nrows_x0, const int stride_row_x, const int nb_y,
+        const q1t_segs segs) {
+    constexpr int nmat           = has_gate ? 2 : 1;
+    constexpr int rows_per_block = rows_per_warp*q1t_nwarps/nsplit;
+    constexpr int lanes_per_row  = WARP_SIZE/rows_per_warp;
+    constexpr bool l2_128        = ncols_c >= 16384;
+    static_assert(nsplit <= q1t_nwarps && rows_per_warp <= WARP_SIZE, "bad q1t config");
+
+    const int nchunks   = (ncols_c ? ncols_c : ncols_x) / QK8_1;
+    const int row_bytes = ncols_c ? ncols_c/QK1_0*int(sizeof(block_q1_0)) : stride_row_x;
+
+    // segment s of a batched launch replaces vx0/dst0/nrows_x0 (segment 0); gate/up is never batched and does not
+    // read segs. Only constant indices: indexing the parameter arrays would copy them to local memory.
+    int          seg     = 0;
+    int          block   = blockIdx.x;
+    const char * vx      = vx0;
+    int          nrows_x = nrows_x0;
+#pragma unroll
+    for (int s = 1; s < (has_gate ? 1 : q1t_max_segs); ++s) {
+        if (s < segs.n && blockIdx.x >= uint32_t(segs.block_end[s - 1])) {
+            seg     = s;
+            block   = blockIdx.x - segs.block_end[s - 1];
+            vx      = segs.vx[s];
+            nrows_x = segs.nrows[s];
+        }
+    }
+
+    const int lane  = threadIdx.x;
+    const int split = threadIdx.y % nsplit;
+    const int row0  = block*rows_per_block + (threadIdx.y / nsplit)*rows_per_warp;
+    const int rbase = min(row0, nrows_x - rows_per_warp);
+
+    // four lanes share one Q1_0 block, each takes 32 of its weights
+    const int d_off  = (lane/4)*int(sizeof(block_q1_0));
+    const int qs_off = d_off + int(offsetof(block_q1_0, qs)) + 4*(lane % 4);
+    const char * x_rows[nmat] = { vx + rbase*row_bytes };
+    if constexpr (has_gate) {
+        x_rows[1] = vgate + rbase*row_bytes;
+    }
+
+    const int  idx    = lane / lanes_per_row;
+    const int  row    = rbase + idx;
+    const bool writer = lane % lanes_per_row == 0 && row >= row0;
+    float bias        = 0.0f;
+    float gate_bias_v = 0.0f;
+    if (writer) {
+        if (x_bias) {
+            bias = x_bias[row];
+        }
+        if (has_gate && gate_bias) {
+            gate_bias_v = gate_bias[row];
+        }
+    }
+
+    ggml_cuda_pdl_sync();
+    const uint4 * y_lo = (const uint4 *) vy;
+    const uint4 * y_hi = y_lo + nb_y;
+    const int2  * y_m  = (const int2 *) (y_hi + nb_y);
+
+    float acc[nmat][rows_per_warp] = {{0.0f}};
+
+    const int nsteps = (nchunks + WARP_SIZE - 1) / WARP_SIZE;
+#pragma unroll
+    for (int s = split; s < nsteps; s += nsplit) {
+        const int c = s*WARP_SIZE + lane;
+        if (ncols_c == 0 || ncols_c % (WARP_SIZE*QK8_1) != 0) {
+            if (c >= nchunks) {
+                break;
+            }
+        }
+        const uint4 lo = y_lo[c];
+        const uint4 hi = y_hi[c];
+        const int2  m  = y_m[c];
+        const int   u[8] = { int(lo.x), int(lo.y), int(lo.z), int(lo.w), int(hi.x), int(hi.y), int(hi.z), int(hi.w) };
+        const float d8 = __int_as_float(m.x);
+
+        const int step_off = s*(WARP_SIZE/4)*int(sizeof(block_q1_0));
+        uint32_t q[nmat][rows_per_warp];
+        float    d1[nmat][rows_per_warp];
+#pragma unroll
+        for (int p = 0; p < nmat; ++p) {
+#pragma unroll
+            for (int r = 0; r < rows_per_warp; ++r) {
+                const char * bx = x_rows[p] + r*row_bytes + step_off;
+                q[p][r]  = q1t_load_u16<l2_128>(bx + qs_off) | (q1t_load_u16<l2_128>(bx + qs_off + 2) << 16);
+                d1[p][r] = __half2float(__ushort_as_half(q1t_load_u16<l2_128>(bx + d_off)));
+            }
+        }
+#pragma unroll
+        for (int p = 0; p < nmat; ++p) {
+#pragma unroll
+            for (int r = 0; r < rows_per_warp; ++r) {
+                acc[p][r] += float(q1t_dot(q[p][r], u, m.y)) * (d1[p][r]*d8);
+            }
+        }
+    }
+
+    // halve the rows held per lane at each step, then finish with a plain butterfly
+#pragma unroll
+    for (int l = 0; (rows_per_warp >> l) > 1; ++l) {
+        const int  h     = rows_per_warp >> (l + 1);
+        const int  off   = (WARP_SIZE/2) >> l;
+        const bool upper = lane & off;
+#pragma unroll
+        for (int i = 0; i < h; ++i) {
+#pragma unroll
+            for (int p = 0; p < nmat; ++p) {
+                const float send = upper ? acc[p][i]     : acc[p][i + h];
+                const float keep = upper ? acc[p][i + h] : acc[p][i];
+                acc[p][i] = keep + __shfl_xor_sync(0xffffffff, send, off, WARP_SIZE);
+            }
+        }
+    }
+#pragma unroll
+    for (int off = lanes_per_row/2; off > 0; off >>= 1) {
+#pragma unroll
+        for (int p = 0; p < nmat; ++p) {
+            acc[p][0] += __shfl_xor_sync(0xffffffff, acc[p][0], off, WARP_SIZE);
+        }
+    }
+
+    if constexpr (nsplit > 1) {
+        __shared__ float partial[q1t_nwarps][nmat][rows_per_warp];
+        if (lane % lanes_per_row == 0) {
+#pragma unroll
+            for (int p = 0; p < nmat; ++p) {
+                partial[threadIdx.y][p][idx] = acc[p][0];
+            }
+        }
+        __syncthreads();
+        if (split != 0) {
+            return;
+        }
+#pragma unroll
+        for (int k = 1; k < nsplit; ++k) {
+#pragma unroll
+            for (int p = 0; p < nmat; ++p) {
+                acc[p][0] += partial[threadIdx.y + k][p][idx];
+            }
+        }
+    }
+
+    if (!writer) {
+        return;
+    }
+    float result = acc[0][0] + bias;
+    if constexpr (has_gate) {
+        const float gate_value = acc[nmat - 1][0] + gate_bias_v;
+        switch (glu_op) {
+            case GGML_GLU_OP_SWIGLU:
+                result *= ggml_cuda_op_silu_single(gate_value);
+                break;
+            case GGML_GLU_OP_GEGLU:
+                result *= ggml_cuda_op_gelu_single(gate_value);
+                break;
+            case GGML_GLU_OP_SWIGLU_OAI:
+                result = ggml_cuda_op_swiglu_oai_single(gate_value, result);
+                break;
+            case GGML_GLU_OP_SWIGLU_CLAMP:
+                result = ggml_cuda_op_swiglu_clamp_single(gate_value, result, glu_limit);
+                break;
+            default:
+                result = result * gate_value;
+                break;
+        }
+    } else {
+        GGML_UNUSED_VARS(gate_bias_v, glu_op, glu_limit);
+    }
+    float * dst = dst0;
+#pragma unroll
+    for (int s = 1; s < (has_gate ? 1 : q1t_max_segs); ++s) {
+        dst = seg == s ? segs.dst[s] : dst;
+    }
+    dst[row] = result;
+}
+
+template <int rows_per_warp, int nsplit, bool has_gate>
+static void mul_mat_vec_q1_0_q1t_launch(
+        q1t_segs segs, const char * vgate, const char * vy, const float * x_bias, const float * gate_bias,
+        const ggml_glu_op glu_op, const float glu_limit, const int ncols_x,
+        const int stride_row_x, const int nb_y, cudaStream_t stream) {
+    constexpr int rows_per_block = rows_per_warp*q1t_nwarps/nsplit;
+    int nblocks = 0;
+    for (int s = 0; s < segs.n; ++s) {
+        nblocks += (segs.nrows[s] + rows_per_block - 1) / rows_per_block;
+        segs.block_end[s] = nblocks;
+    }
+    const dim3 block_nums(nblocks, 1, 1);
+    const dim3 block_dims(WARP_SIZE, q1t_nwarps, 1);
+    const bool contiguous = stride_row_x == ncols_x/QK1_0*int(sizeof(block_q1_0));
+#define Q1T_CASE(n) \
+    mul_mat_vec_q1_0_q1t<rows_per_warp, nsplit, has_gate, n><<<block_nums, block_dims, 0, stream>>>( \
+        segs.vx[0], vgate, vy, x_bias, gate_bias, glu_op, glu_limit, segs.dst[0], ncols_x, segs.nrows[0], stride_row_x, nb_y, segs)
+    switch (contiguous ? ncols_x : 0) {
+        case  5120: Q1T_CASE( 5120); break;
+        case  6144: Q1T_CASE( 6144); break;
+        case 17408: Q1T_CASE(17408); break;
+        default:    Q1T_CASE(    0); break;
+    }
+#undef Q1T_CASE
+}
+
+template <bool has_gate>
+static void mul_mat_vec_q1_0_q1t_switch(
+        const q1t_segs & segs, const char * vgate, const char * vy, const float * x_bias, const float * gate_bias,
+        const ggml_glu_op glu_op, const float glu_limit, const int ncols_x,
+        const int stride_row_x, const int nb_y, cudaStream_t stream) {
+    constexpr int rows_per_warp = 4;
+    int nrows_x = 0;
+    for (int s = 0; s < segs.n; ++s) {
+        nrows_x += segs.nrows[s];
+    }
+    if (segs.n == 1 && nrows_x < rows_per_warp) {
+        mul_mat_vec_q1_0_q1t_launch<1, q1t_nwarps, has_gate>(
+            segs, vgate, vy, x_bias, gate_bias, glu_op, glu_limit, ncols_x, stride_row_x, nb_y, stream);
+        return;
+    }
+    // Split K across warps when there are too few row groups to keep every SM busy for a few waves. For rows up to
+    // 8192 wide, two warps walking adjacent K steps together also read the sectors those steps share only once;
+    // with one warp per row L2 evicted them in between (gate/up K = 5120: 32.4 -> 26.3 MB DRAM reads).
+    const int nsm    = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    const int nwarps = (nrows_x + rows_per_warp - 1) / rows_per_warp;
+    const int nsteps = (ncols_x/QK8_1 + WARP_SIZE - 1) / WARP_SIZE;
+    // Measured on GTX 1660 SUPER per launch: gate/up K = 5120 89.0 -> 84.6 us with 4 splits instead of 2, 5120 x 6144
+    // 23.8 -> 20.5 us with 4 instead of 2, while K = 17408 is fastest with 2 (47.7 us; 50.5 with 4).
+    // Without a gate, large launches of rows up to 8192 wide do best with 8 rows per warp (half the activation
+    // loads per row, more weight loads in flight) and 4 splits: qkv+z 47.4 -> 41.8 us, q+k+v 41.9 -> 36.9 us,
+    // lm head 657 -> 583 us. K = 17408 stays at 4 rows and 2 splits (49.5 us with 8x4 against 47.8).
+    if constexpr (!has_gate) {
+        int min_seg_rows = INT_MAX;
+        for (int s = 0; s < segs.n; ++s) {
+            min_seg_rows = std::min(min_seg_rows, segs.nrows[s]);
+        }
+        if (ncols_x <= 8192 && nsteps >= 4 && min_seg_rows >= 8 && nrows_x >= 4096) {
+            mul_mat_vec_q1_0_q1t_launch<8, 4, has_gate>(
+                segs, vgate, vy, x_bias, gate_bias, glu_op, glu_limit, ncols_x, stride_row_x, nb_y, stream);
+            return;
+        }
+    }
+    const int max_split = ncols_x > 8192 ? 2 : q1t_nwarps;
